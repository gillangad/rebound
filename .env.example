# Each capability is selected independently. Fixture is the safe default for Try Demo.
AGENT_PROVIDER=fixture
# fixture uses the labelled local Email/Drive corpus; google uses the
# server-side adapter; composio is a declared deferred boundary.
EVIDENCE_PROVIDER=fixture
PAYMENT_PROVIDER=fixture
# APP_MODE is accepted only as a backwards-compatible shortcut for older local files.
APP_MODE=fixture
PRODUCT_NAME=Rebound
APP_BASE_URL=http://localhost:3000
DEMO_SESSION_SECRET=replace_with_a_long_random_server_secret

# Optional for durable local/hosted behavior and pg-boss. Leave commented for
# the credential-free fixture preview.
# DATABASE_URL=postgres://recovery:recovery@localhost:5432/recovery

# Required only when PAYMENT_PROVIDER=razorpay_test.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Required only when AGENT_PROVIDER=fireworks. Never expose this to the browser.
FIREWORKS_API_KEY=replace_me
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731

# Required only when AGENT_PROVIDER=codex_app_server. This is the native
# local JSON-RPC transport; the app spawns `codex app-server --stdio` with an
# allowlisted environment and never forwards app or browser secrets.
CODEX_APP_SERVER_URL=stdio://
CODEX_APP_SERVER_COMMAND=codex
# Optional native model override and hard request timeout.
# CODEX_APP_SERVER_MODEL=gpt-5.4-mini
# CODEX_APP_SERVER_TIMEOUT_MS=45000

# Required only when EVIDENCE_PROVIDER=google. Keep the token server-side.
GOOGLE_ACCESS_TOKEN=replace_me
# TOKEN_ENCRYPTION_KEY is required when a connected Google token is stored in
# the encrypted connector envelope instead of GOOGLE_ACCESS_TOKEN.
TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_key

# Optional fixture webhook secret for local signed payload tests.
FIXTURE_WEBHOOK_SECRET=fixture-only-secret
