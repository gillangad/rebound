{
  "name": "rebound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:all": "tsx src/dev-all.ts",
    "dev:worker": "tsx src/worker/index.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:prod": "tsx src/worker/index.ts",
    "build": "next build",
    "start": "next start",
    "start:prod": "npm run db:migrate && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "evaluate": "tsx src/server/evaluation/runner.ts",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:reset-demo": "tsx src/server/db/reset-demo.ts",
    "setup": "npm install && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@ai-sdk/fireworks": "^3.0.0",
    "ai": "^7.0.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pg-boss": "^12.5.0",
    "postgres": "^3.4.5",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.55.0",
    "postcss": "^8.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
